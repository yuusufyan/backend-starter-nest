NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=backend_starter
DB_SSL=false

# Redis (menyimpan refresh token). Tanpa REDIS_PASSWORD berarti tanpa autentikasi (hanya lokal).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rahasia penanda tangan access token (JWT, HS256). WAJIB, minimal 32 karakter, tanpa default.
# Buat dengan: openssl rand -base64 48. Jangan isi nilai asli di file ini.
JWT_SECRET=

# Seeder superadmin (bun run seed). Email dan password WAJIB diisi, tanpa default.
# Password minimal 8 karakter, maksimal 72 byte. Jangan isi password asli di file ini.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=

# Hanya untuk test integrasi (bun run test:int), isi dengan Postgres lokal/CI
TEST_DATABASE_URL=
# Redis sungguhan untuk test integrasi store refresh token (Redis >= 6.2). Pakai Redis dev/test saja.
TEST_REDIS_URL=
