NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=backend_starter
DB_SSL=false

# Seeder superadmin (bun run seed). Email dan password WAJIB diisi, tanpa default.
# Password minimal 8 karakter, maksimal 72 byte. Jangan isi password asli di file ini.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=

# Hanya untuk test integrasi (bun run test:int), isi dengan Postgres lokal/CI
TEST_DATABASE_URL=
